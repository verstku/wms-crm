# Backend settings. To change the database password: update it in the root .env and in both
# URLs below in backend/.env, then recreate the volume with `docker compose down -v`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wms_crm
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wms_crm_test
USE_TEST_DATABASE=false
